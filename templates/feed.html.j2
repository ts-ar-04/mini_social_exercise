{% extends "base.html.j2" %}
{% block content %}
{% from "macros/user_macros.html.j2" import user_display %}

<div class="align-center text-center">
  <img src="{{ url_for('static', filename='icon.png') }}" alt="Logo" style="height: 64px;" class="mb-4">
</div>

{% if session.get('user_id') %}
<div class="col-md-8 mx-auto mb-4">
  <div class="card shadow-sm">
    <div class="card-body">
      <h5 class="card-title">Create a new post</h5>
      <form action="{{ url_for('add_post') }}" method="POST">
        <div class="mb-3">
          <textarea class="form-control" name="content" rows="3" placeholder="What's on your mind, {{ session.get('username') }}?" required></textarea>
        </div>
        <button type="submit" class="btn btn-primary float-end">Post</button>
      </form>
    </div>
  </div>
</div>

<!-- ===== Assignment 1, Feature 2: weekly goal progress (Design Claims 13-15) ===== -->
<div class="col-md-8 mx-auto mb-4">
  {% if goal_progress %}
  <div class="card shadow-sm {% if goal_progress.completed %}border-success{% elif goal_progress.deadline_close %}border-danger{% endif %}">
    <div class="card-body">
      <div class="d-flex justify-content-between align-items-center mb-2">
        <h5 class="card-title mb-0">🎯 This week's goal</h5>
        <!-- Deadline countdown (Claim 14) -->
        {% if goal_progress.completed %}
          <span class="badge text-bg-success">Goal reached 🎉</span>
        {% else %}
          <span class="badge {% if goal_progress.deadline_close %}text-bg-danger{% else %}text-bg-secondary{% endif %}">
            ⏳ {{ goal_progress.days_left }}d {{ goal_progress.hours_left }}h left
          </span>
        {% endif %}
      </div>
      <!-- Progress bars give continuous feedback (Claim 15) -->
      <small>Posts: {{ goal_progress.posts_done }} / {{ goal_progress.posts_goal }}</small>
      <div class="progress mb-2" style="height: 14px;">
        <div class="progress-bar {% if goal_progress.posts_pct >= 100 %}bg-success{% endif %}" style="width: {{ goal_progress.posts_pct }}%;">{{ goal_progress.posts_pct }}%</div>
      </div>
      <small>Comments: {{ goal_progress.comments_done }} / {{ goal_progress.comments_goal }}</small>
      <div class="progress mb-2" style="height: 14px;">
        <div class="progress-bar {% if goal_progress.comments_pct >= 100 %}bg-success{% endif %}" style="width: {{ goal_progress.comments_pct }}%;">{{ goal_progress.comments_pct }}%</div>
      </div>
      <a href="{{ url_for('goals') }}" class="small">Details and community comparison →</a>
    </div>
  </div>
  {% else %}
  <!-- No goal yet: invite the user to set one -->
  <div class="alert alert-info d-flex justify-content-between align-items-center mb-0">
    <span>🎯 You haven't set a weekly goal yet. Members with a goal contribute more!</span>
    <a href="{{ url_for('goals') }}" class="btn btn-sm btn-primary">Set a goal</a>
  </div>
  {% endif %}
</div>

<!-- ===== Assignment 1, Feature 3: "Return the favor" (Design Claim 31) ===== -->
{% if favors %}
<div class="col-md-8 mx-auto mb-4">
  <div class="card shadow-sm border-warning">
    <div class="card-body">
      <h5 class="card-title">🤝 Return the favor</h5>
      <p class="text-muted small mb-3">These members engaged with your posts. Show them some love back!</p>
      {% for favor in favors %}
      <div class="border rounded p-2 mb-2">
        <!-- Who helped me, and how much (the specific "favor" to return) -->
        <div class="small mb-1">
          <strong><a href="{{ url_for('user_profile', username=favor.post.username) }}">@{{ favor.post.username }}</a></strong>
          {% if favor.n_comments %}commented {{ favor.n_comments }}×{% endif %}
          {% if favor.n_comments and favor.n_reactions %} and {% endif %}
          {% if favor.n_reactions %}reacted {{ favor.n_reactions }}×{% endif %}
          on your posts. You've engaged with theirs {{ favor.given }}×.
        </div>
        <!-- Their newest post I haven't engaged with yet -->
        <p class="mb-2 fst-italic">"{{ favor.post.content|truncate(140) }}"</p>
        <div class="d-flex gap-2 align-items-center">
          <!-- One-click reaction: reuses the existing /react route -->
          <form action="{{ url_for('add_reaction') }}" method="POST" class="d-inline">
            <input type="hidden" name="post_id" value="{{ favor.post.id }}">
            <input type="hidden" name="reaction" value="like">
            <button type="submit" class="btn btn-sm btn-light">❤️ Like</button>
          </form>
          <!-- Quick reply: reuses the existing comment route -->
          <form action="{{ url_for('add_comment', post_id=favor.post.id) }}" method="POST" class="d-flex flex-grow-1 gap-2">
            <input type="text" name="content" class="form-control form-control-sm" placeholder="Reply to @{{ favor.post.username }}…" required>
            <button type="submit" class="btn btn-sm btn-warning">Reply</button>
          </form>
        </div>
      </div>
      {% endfor %}
    </div>
  </div>
</div>
{% endif %}

<!-- ===== Assignment 3, Feature B: reminder to introduce yourself (Design Claim 19) ===== -->
{% if show_intro_prompt %}
<div class="col-md-8 mx-auto mb-4">
  <div class="alert alert-success d-flex justify-content-between align-items-center mb-0">
    <span>🌱 You're new here! Tell the community a bit about yourself so members can say hi.</span>
    <a href="{{ url_for('introduce') }}" class="btn btn-sm btn-success">Introduce yourself</a>
  </div>
</div>
{% endif %}

<!-- ===== Assignment 3, Feature A: welcome new members (Design Claim 18) ===== -->
{% if newcomers %}
<div class="col-md-8 mx-auto mb-4">
  <div class="card shadow-sm border-success">
    <div class="card-body">
      <h5 class="card-title">🌱 Say hi to our newest members</h5>
      <p class="text-muted small mb-3">They joined in the last two weeks. A friendly first reply makes newcomers much more likely to stay.</p>
      {% for n in newcomers %}
      <div class="border rounded p-2 mb-2">
        <div class="small mb-1">
          <strong><a href="{{ url_for('user_profile', username=n.username) }}">@{{ n.username }}</a></strong>
          <span class="badge text-bg-success">New member</span>
          joined {% if n.days == 0 %}today{% else %}{{ n.days }} day{{ 's' if n.days != 1 }} ago{% endif %}
          {% if n.replies_received == 0 %}· <span class="text-danger">nobody has replied to them yet</span>{% endif %}
        </div>
        {% if n.profile %}<p class="small text-muted mb-1">"{{ n.profile|truncate(120) }}"</p>{% endif %}
        {% if n.post %}
          <p class="mb-2 fst-italic">"{{ n.post.content|truncate(140) }}"</p>
          {% if n.already_welcomed %}
            <span class="small text-success">✓ You already welcomed @{{ n.username }}</span>
          {% else %}
          <!-- Friendly reply, pre-filled but editable; reuses the normal comment route -->
          <form action="{{ url_for('add_comment', post_id=n.post.id) }}" method="POST" class="d-flex gap-2">
            <input type="text" name="content" class="form-control form-control-sm"
                   value="Welcome to MiniSocial, @{{ n.username }}! 👋 Glad to have you here." required>
            <button type="submit" class="btn btn-sm btn-success text-nowrap">👋 Welcome</button>
          </form>
          {% endif %}
        {% else %}
          <p class="small text-muted mb-0">Hasn't posted yet. <a href="{{ url_for('user_profile', username=n.username) }}">Visit their profile</a>.</p>
        {% endif %}
      </div>
      {% endfor %}
    </div>
  </div>
</div>
{% endif %}
{% endif %}

<h2 class="text-center border-bottom pb-2 mb-4"><span>Posts</span></h2>

<div class="mb-4 text-center">

<!-- This is the 'sort' filter for New / Popular / Recommended -->
  <div class="btn-group me-5" role="group" aria-label="Sort posts">
    <!-- The link preserves the current_show state -->
    <a href="{{ url_for('feed', sort='new', show=current_show) }}" class="btn {% if current_sort == 'new' %}btn-primary{% else %}btn-light{% endif %}">New</a>
    <a href="{{ url_for('feed', sort='popular', show=current_show) }}" class="btn {% if current_sort == 'popular' %}btn-primary{% else %}btn-light{% endif %}">Popular</a>
    <a href="{{ url_for('feed', sort='recommended', show=current_show) }}" class="btn {% if current_sort == 'recommended' %}btn-primary{% else %}btn-light{% endif %}">Recommended</a>
  </div>

  <!-- This is the 'show' filter for All / Following -->
  <!-- Following is only shown to logged in users -->
  {% if session.get('user_id') %}
  <div class="btn-group" role="group" aria-label="Filter posts">
    <!-- The link preserves the current_sort state -->
    <a href="{{ url_for('feed', sort=current_sort, show='all') }}" class="btn {% if current_show == 'all' %}btn-primary{% else %}btn-light{% endif %}">All</a>
    <a href="{{ url_for('feed', sort=current_sort, show='following') }}" class="btn {% if current_show == 'following' %}btn-primary{% else %}btn-light{% endif %}">Following</a>
    <!-- Assignment 1, Feature 1: filter that lists only the posts that still need a reply -->
    <a href="{{ url_for('feed', sort=current_sort, show='unanswered') }}" class="btn {% if current_show == 'unanswered' %}btn-danger{% else %}btn-light{% endif %}">💬 Needs a reply ({{ unanswered_count }})</a>
  </div>
   {% endif %}


</div>

<!-- Assignment 1, Feature 1: explain what the "needed contribution" is in this view -->
{% if current_show == 'unanswered' %}
<div class="col-md-8 mx-auto mb-4">
  <div class="alert alert-warning mb-0">
    <strong>{{ unanswered_count }} posts are still waiting for their first reply.</strong>
    Every post here was written by a member hoping for a response. Pick one and be the first to reply,
    once you comment, the post leaves this list.
  </div>
</div>
{% endif %}

<div class="col-md-8 mx-auto">
  {% for entry in posts %}
  <div class="card mb-4" id="post-{{ entry.post.id }}">
    <div class="card-body">
      <div class="d-flex justify-content-between align-items-center">
        <h3 class="card-title mb-0">
          {% if entry.followed_poster %}
          <a href="/u/{{ entry.post.user_id }}">{{ user_display(entry.post.username) }}<span class="text-success p-1" data-toggle="tooltip" data-placement="top" title="You are following this user"> ✓ </span>
</a>
          {% else %}
          <a href="/u/{{ entry.post.user_id }}">{{ user_display(entry.post.username) }} </a>
          {% endif %}
        </h3>

        
        {% if session.get('user_id') == entry.post.user_id %}
        <div class="d-flex align-items-center">
            <small class="text-muted me-3">{{ entry.post.created_at|datetimeformat }}</small>
            <form action="{{ url_for('delete_post', post_id=entry.post.id) }}" method="POST" onsubmit="return confirm('Are you sure you want to delete this post?');">
                <button type="submit" class="btn btn-danger" title="Delete Post">
                   delete
                </button>
            </form>
        </div>
        {% else %}
        <small class="text-muted">{{ entry.post.created_at|datetimeformat }}</small>
        {% endif %}
      </div>
      
      <!-- Assignment 3, Feature A/B: newcomer and introduction badges -->
      {% if entry.post.is_newcomer or entry.post.is_intro %}
      <div class="mt-1">
        {% if entry.post.is_newcomer %}<span class="badge text-bg-success">🌱 New member</span>{% endif %}
        {% if entry.post.is_intro %}<span class="badge text-bg-info">👋 Introduction</span>{% endif %}
      </div>
      {% endif %}

      <p class="mt-2">{{ entry.post.content }}</p>

      <!-- Assignment 3.1: why this post was recommended -->
      {% if current_sort == 'recommended' and entry.post.reason %}
      <p class="small text-primary mb-2">💡 {{ entry.post.reason }}</p>
      {% endif %}

      <!-- Assignment 1, Feature 1: highlight posts that still need their first reply -->
      {% if not entry.comments and session.get('user_id') and session.get('user_id') != entry.post.user_id %}
      <div class="alert alert-warning py-1 px-2 small d-flex justify-content-between align-items-center">
        <span>💬 No replies yet{% if entry.days_waiting %}, waiting {{ entry.days_waiting }} day{{ 's' if entry.days_waiting != 1 }}{% endif %}. Be the first!</span>
        <button class="btn btn-sm btn-warning py-0" data-bs-toggle="modal" data-bs-target="#addCommentModal-{{ entry.post.id }}">Reply</button>
      </div>
      {% endif %}

      <!-- Reactions Display and Add Reaction Button -->
      <div class="d-flex align-items-center mt-2 mb-2">
        <!-- Display existing reactions -->
        <div class="reactions-display me-2">
            {% if entry.reactions %}
              {% for react in entry.reactions %}
                {% if react.reaction_type == entry.user_reaction %}
                  <form action="{{ url_for('unreact') }}" method="post" class="d-inline">
                    <input type="hidden" name="post_id" value="{{ entry.post.id }}">
                    <button type="submit" class="btn btn-light text-dark me-1" title="{{ react.reaction_type|capitalize }}">
                      {{ reaction_emojis.get(react.reaction_type, '👍') }} {{ react.count }}
                    </button>
                  </form>
                {% else %}
                  <span class=" text-dark me-1" title="{{ react.reaction_type|capitalize }}">
                    {{ reaction_emojis.get(react.reaction_type, '👍') }} {{ react.count }}
                  </span>
                {% endif %}
              {% endfor %}
            {% else %}
              <span class="text-muted"> No reactions yet </span>
            {% endif %}
        </div>

        <!-- Add Reaction Dropdown Button -->
        {% if session.get('user_id') %}
        <div class="dropdown">
          <button class="btn btn-sm btn-light text-dark rounded-circle m-0" type="button" id="dropdownMenuButton-{{ entry.post.id }}" data-bs-toggle="dropdown" aria-expanded="false" title="Add Reaction" >
            +
          </button>
          <ul class="dropdown-menu" aria-labelledby="dropdownMenuButton-{{ entry.post.id }}">
            {% for reaction_type in reaction_types %}
            <li>
              <form action="{{ url_for('add_reaction') }}" method="POST" class="d-inline">
                <input type="hidden" name="post_id" value="{{ entry.post.id }}">
                <input type="hidden" name="reaction" value="{{ reaction_type }}">
                <button type="submit" class="dropdown-item">
                  {{ reaction_emojis.get(reaction_type, '👍') }} {{ reaction_type|capitalize }}
                </button>
              </form>
            </li>
            {% endfor %}
          </ul>
        </div>
        {% endif %}
      </div>


     {% if entry.comments %}
      <hr>
      {% if entry.comments %}
        <h6 class="mb-0">Comments ({{ entry.comments | count }})</h4>
      {% else %}
        <h6 class="mb-0">Comments</h4>
      {% endif %}
      <ul class="list-group list-group-flush shadow-none border-0">
        {% for comment in entry.comments[-2:] %}
        <li class="card shadow-none p-2 mt-2">
          <div class="d-flex justify-content-between">
            <div>
              <strong><a href="/u/{{ comment.username }}">{{ user_display(comment.username) }}</a></strong>
              <p class="mb-0">{{ comment.content }}</p>
            </div>
            
            {% if session.get('user_id') == comment.user_id or session.get('user_id') == entry.post.user_id %}
            <form action="{{ url_for('delete_comment', comment_id=comment.id) }}" method="POST" onsubmit="return confirm('Are you sure you want to delete this comment?');">
                <button type="submit" class="btn btn-sm btn-danger" title="Delete Comment">delete</button>
            </form>
            {% endif %}

          </div>
        </li>
        {% endfor %}
      </ul>
      {% endif %}

      <div class="d-flex justify-content-between mt-3">
        <a href="/posts/{{ entry.post.id }}" class="btn btn-sm btn-light show-comments-btn">
          Show all comments
        </a>
        <button class="btn btn-primary btn-sm" data-bs-toggle="modal" data-bs-target="#addCommentModal-{{ entry.post.id }}">Add Comment</button>
      </div>
    </div>
  </div>
  

  <div class="modal fade" id="addCommentModal-{{ entry.post.id }}" tabindex="-1" aria-labelledby="addCommentModalLabel-{{ entry.post.id }}" aria-hidden="true">
    <div class="modal-dialog">
      <div class="modal-content">
        <div class="modal-header">
          <h5 class="modal-title" id="addCommentModalLabel-{{ entry.post.id }}">Add a comment</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <div class="modal-body">
          <form action="/posts/{{ entry.post.id }}/comment" method="POST">
            <div class="mb-3">
              <label for="comment-content-{{ entry.post.id }}" class="form-label">Your Comment</label>
              <textarea class="form-control" id="comment-content-{{ entry.post.id }}" name="content" rows="3" required></textarea>
            </div>
            <button type="submit" class="btn btn-primary">Submit Comment</button>
          </form>
        </div>
      </div>
    </div>
  </div>

  {% else %}
  <p class="text-center">No posts to display.</p>
  {% endfor %}
</div>

  <div class="d-flex justify-content-center align-items-center my-4">
    <a href="{{ url_for('feed', page=page-1, sort=current_sort, show=current_show) }}"
      class="btn btn-primary {% if page <= 1 %}btn-light disabled{% endif %}">
      &laquo; Previous
    </a>
    <span class="mx-3 text-muted">Page {{ page }}</span>
    <a href="{{ url_for('feed', page=page+1, sort=current_sort, show=current_show) }}"
      class="btn btn-primary {% if posts|length < per_page %}disabled{% endif %}">
      Next &raquo;
    </a>
  </div>
{% endblock %}